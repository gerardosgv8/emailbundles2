# Lemon Squeezy — mode switch (see LEMON_SQUEEZY_MIGRATION.md § Go live)
# test (default): wizard verify + checkout use test LS data
# live: flip this one var on Vercel after filling *_LIVE vars below
LEMONSQUEEZY_MODE=test

# Test mode (active while LEMONSQUEEZY_MODE=test)
LEMONSQUEEZY_API_KEY=
# Optional override; default test checkout URL is in api/_lib/lemonSqueezyConfig.ts
# LEMONSQUEEZY_CHECKOUT_URL=
LEMONSQUEEZY_VARIANT_STARTER_KIT=

# Live mode (used when LEMONSQUEEZY_MODE=live)
LEMONSQUEEZY_API_KEY_LIVE=
LEMONSQUEEZY_CHECKOUT_URL_LIVE=
LEMONSQUEEZY_VARIANT_STARTER_KIT_LIVE=

# Wizard buyer gate — HMAC secret for signed session tokens (generate a long random string)
WIZARD_SESSION_SECRET=
# Session length in days (default 7)
WIZARD_SESSION_DAYS=7
# Max distinct browsers/devices per order (default 2; requires Vercel KV)
WIZARD_MAX_DEVICES_PER_ORDER=2
# Optional — Bearer token for GET /api/wizard-unlock-audit?orderId=… (sharing investigation)
# WIZARD_AUDIT_SECRET=

# Upstash Redis (Vercel Marketplace) — required for device limits and sharing audit
# Vercel KV is discontinued. Use Upstash Redis; either env pair works:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Site URLs (Vercel API)
SITE_URL=https://www.mailcraft.studio
ALLOWED_ORIGINS=http://localhost:5174,https://www.mailcraft.studio,https://mailcraft.studio,https://gerardosgv8.github.io

# Support
SUPPORT_EMAIL=hello@mailcraft.studio

# Optional — Resend post-purchase email (not used on current buy path)
# RESEND_API_KEY=re_...
# EMAIL_FROM=Mailcraft Studio <hello@mailcraft.studio>
# RESEND_PURCHASE_TEMPLATE_ID=mailcraft-studio-intro

# Frontend (Vite) — baked into GitHub Pages at build time
# VITE_API_URL=https://emailbundles2.vercel.app
#
# Local dev: defaults to the deployed Vercel API. To use `vercel dev` instead:
# VITE_API_URL=http://localhost:3000
